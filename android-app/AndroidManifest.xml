<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mermergi.dsh"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- The floating work-status bubble; granted from a system settings screen, not a dialog. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Drives the Xiaomi Super Island notification that shows the work state. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the loopback dsh server warm: Termux gets force-stopped when its recent-tasks
         entry is cleared, which takes the detached `dsh web` process down with it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Package visibility (API 30+): we must be able to resolve Termux and its API app. -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.api" />
    </queries>

    <application
        android:label="DSH"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Handoff channel: Termux calls `termux-open-url 'dshapp://open?url=...'`. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dshapp" />
            </intent-filter>
        </activity>

        <!-- `specialUse`: the honest type for "keep a local service reachable". The subtype is
             required by Android 14 when a service declares this type. `stopWithTask=false`
             keeps it alive when the app's card is dismissed from the recent-tasks list. -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Probe the loopback DSH server and restart it after Android kills the Termux process tree" />
        </service>
    </application>
</manifest>
