{
  "name": "dsh-termux",
  "version": "0.1.0",
  "description": "Run DeepSeek Harness (dsh) on Android/Termux with one command: installs it into a fixed directory, applies the Android patches, and starts the Web UI.",
  "keywords": ["deepseek", "dsh", "termux", "android", "harness", "agent"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-termux": "./bin.mjs"
  },
  "files": ["bin.mjs", "android-fix.mjs", "README.md"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "os": ["linux", "darwin", "win32"],
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../android-fix.mjs','android-fix.mjs')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mermergi/deepseek-harness-termux.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/mermergi/deepseek-harness-termux",
  "bugs": {
    "url": "https://github.com/mermergi/deepseek-harness-termux/issues"
  }
}
